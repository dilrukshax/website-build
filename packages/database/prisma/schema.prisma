generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Load .env from monorepo root
  // Run Prisma commands from root: pnpm db:migrate / pnpm db:seed
}

// ============================================================
// USER (Global auth entity — not tenant-scoped)
// ============================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  isSuperAdmin Boolean    @default(false) @map("is_super_admin")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenants             UserTenant[]
  ownedTenants        Tenant[]             @relation("TenantOwner")
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  @@map("users")
}

enum UserStatus {
  active
  inactive
}

// ============================================================
// TENANT (Organization / business entity)
// ============================================================

model Tenant {
  id           String       @id @default(uuid())
  businessName String       @map("business_name")
  ownerId      String       @map("owner_id")
  status       TenantStatus @default(active)
  plan         PlanTier     @default(free)
  billingInterval BillingInterval @default(monthly) @map("billing_interval")
  addonBundles Int          @default(0) @map("addon_bundles")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  owner             User                 @relation("TenantOwner", fields: [ownerId], references: [id])
  users             UserTenant[]
  roles             Role[]
  instances         Instance[]
  domainRoutes      DomainRoute[]
  feedbacks         Feedback[]
  subscription      TenantSubscription?
  creditWallet      TenantCreditWallet?
  billingCharges    BillingCharge[]
  creditLedgerEntries TenantCreditLedger[]
  redemptions       ReferralRedemption[]

  @@map("tenants")
}

enum TenantStatus {
  active
  inactive
  suspended
}

enum PlanTier {
  free
  starter
  freelance
  enterprise
}

enum BillingInterval {
  monthly
  annual
}

enum SubscriptionStatus {
  active
  inactive
}

enum BillingChargeType {
  plan_change
  addon_bundle
}

enum BillingChargeStatus {
  pending
  confirmed
  rejected
}

enum CreditLedgerType {
  credit
  debit
  adjustment
}

enum ReferralRewardMilestone {
  free_activation
  starter_monthly
  starter_annual
  freelance_monthly
  freelance_annual
  enterprise_small
  enterprise_medium
  enterprise_large
}

enum ReferralRewardStatus {
  pending
  granted
  rejected
}

enum ReferralPointLedgerType {
  credit
  debit
  expiry
}

enum ReferralRedemptionStatus {
  completed
  cancelled
}

enum EnterpriseRewardTier {
  small
  medium
  large
}

enum EnterpriseRewardReviewStatus {
  approved
  rejected
}

model PlanCatalog {
  id                     String   @id @default(uuid())
  plan                   PlanTier @unique
  monthlyPriceCents      Int      @map("monthly_price_cents")
  annualPriceCents       Int      @map("annual_price_cents")
  maxInstances           Int?     @map("max_instances")
  maxCustomDomains       Int?     @map("max_custom_domains")
  maxPagesPerInstance    Int?     @map("max_pages_per_instance")
  maxAccessibleThemes    Int?     @map("max_accessible_themes")
  allowPremiumTemplates  Boolean  @default(true) @map("allow_premium_templates")
  maxBookingsPerDay      Int?     @map("max_bookings_per_day")
  maxActiveServices      Int?     @map("max_active_services")
  allowStaffAccounts     Boolean  @default(true) @map("allow_staff_accounts")
  allowAddonBundle       Boolean  @default(false) @map("allow_addon_bundle")
  addonMonthlyPriceCents Int?     @map("addon_monthly_price_cents")
  addonAnnualPriceCents  Int?     @map("addon_annual_price_cents")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("plan_catalogs")
}

model PlanReferralMultiplier {
  id         String   @id @default(uuid())
  plan       PlanTier @unique
  multiplier Decimal  @db.Decimal(6, 3)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("plan_referral_multipliers")
}

model ReferralRewardRule {
  id        String                  @id @default(uuid())
  milestone ReferralRewardMilestone @unique
  basePoints Int                    @map("base_points")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@map("referral_reward_rules")
}

model TenantSubscription {
  id               String             @id @default(uuid())
  tenantId         String             @unique @map("tenant_id")
  plan             PlanTier
  billingInterval  BillingInterval    @map("billing_interval")
  addonBundles     Int                @default(0) @map("addon_bundles")
  status           SubscriptionStatus @default(active)
  startedAt        DateTime           @default(now()) @map("started_at")
  currentPeriodEnd DateTime?          @map("current_period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([plan, billingInterval])
  @@map("tenant_subscriptions")
}

model BillingCharge {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  requestedByUserId     String            @map("requested_by_user_id")
  chargeType            BillingChargeType @map("charge_type")
  requestedPlan         PlanTier?         @map("requested_plan")
  requestedInterval     BillingInterval?  @map("requested_interval")
  requestedAddonBundles Int?              @map("requested_addon_bundles")
  amountCents           Int               @map("amount_cents")
  creditAppliedCents    Int               @default(0) @map("credit_applied_cents")
  netAmountCents        Int               @map("net_amount_cents")
  currency              String            @default("USD")
  status                BillingChargeStatus @default(pending)
  notes                 String?
  metadataJsonb         Json?             @map("metadata_jsonb")
  reviewedByUserId      String?           @map("reviewed_by_user_id")
  reviewedAt            DateTime?         @map("reviewed_at")
  rejectionReason       String?           @map("rejection_reason")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditLedgerEntries TenantCreditLedger[]
  rewardEvents       ReferralRewardEvent[]

  @@index([tenantId, status, createdAt])
  @@map("billing_charges")
}

model TenantCreditWallet {
  id          String   @id @default(uuid())
  tenantId    String   @unique @map("tenant_id")
  balanceCents Int     @default(0) @map("balance_cents")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TenantCreditLedger[]

  @@map("tenant_credit_wallets")
}

model TenantCreditLedger {
  id           String           @id @default(uuid())
  walletId     String           @map("wallet_id")
  tenantId     String           @map("tenant_id")
  chargeId     String?          @map("charge_id")
  redemptionId String?          @map("redemption_id")
  entryType    CreditLedgerType @map("entry_type")
  amountCents  Int              @map("amount_cents")
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at")

  wallet     TenantCreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge     BillingCharge?     @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  redemption ReferralRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([tenantId, createdAt])
  @@map("tenant_credit_ledger")
}

// ============================================================
// INSTANCE (Website / business unit within a tenant)
// ============================================================

model Instance {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  subdomain     String         @unique
  fullDomain    String?        @map("full_domain")
  customDomain  String?        @unique @map("custom_domain")
  cloudflareAccountId String?  @map("cloudflare_account_id")
  cloudflareHostnameId String? @map("cloudflare_hostname_id")
  customDomainHostnameStatus String? @map("custom_domain_hostname_status")
  customDomainSslStatus String? @map("custom_domain_ssl_status")
  customDomainLastCheckedAt DateTime? @map("custom_domain_last_checked_at")
  customDomainActivatedAt DateTime? @map("custom_domain_activated_at")
  customDomainSetupJsonb Json? @map("custom_domain_setup_jsonb")
  timezone      String         @default("UTC")
  name          String
  businessType  String?        @map("business_type")
  industryId    String?        @map("industry_id")
  settingsJsonb Json?          @map("settings_jsonb")
  status        InstanceStatus @default(active)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industry       Industry?       @relation(fields: [industryId], references: [id])
  customers      Customer[]
  services       Service[]
  products       Product[]
  blogPosts      BlogPost[]
  bookings       Booking[]
  inquiries      Inquiry[]
  toggles        FeatureToggle[]
  pages          Page[]
  pageSections   PageSection[]
  publishRecords PublishRecord[]
  mediaAssets    MediaAsset[]
  domainRoutes   DomainRoute[]
  cloudflareAccount CloudflareAccount? @relation(fields: [cloudflareAccountId], references: [id], onDelete: SetNull)
  domainAccountHistory CustomDomainAccountHistory[]

  @@index([tenantId])
  @@index([cloudflareAccountId])
  @@map("instances")
}

model DomainRoute {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  instanceId String   @map("instance_id")
  host       String   @unique
  active     Boolean  @default(true)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([instanceId, active])
  @@index([instanceId, isPrimary])
  @@map("domain_routes")
}

enum InstanceStatus {
  active
  inactive
}

enum CustomDomainAccountEventType {
  attached
  reassigned
  detached
  legacy_import
}

model CloudflareAccount {
  id                 String   @id @default(uuid())
  name               String
  cloudflareAccountId String? @map("cloudflare_account_id")
  zoneId             String   @unique @map("zone_id")
  zoneName           String?  @map("zone_name")
  apiTokenEncrypted  String   @map("api_token_encrypted")
  isDefault          Boolean  @default(false) @map("is_default")
  isActive           Boolean  @default(true) @map("is_active")
  fallbackOrigin     String?  @map("fallback_origin")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  instances     Instance[]
  historyFrom   CustomDomainAccountHistory[] @relation("DomainHistoryFromAccount")
  historyTo     CustomDomainAccountHistory[] @relation("DomainHistoryToAccount")

  @@index([isActive, isDefault])
  @@map("cloudflare_accounts")
}

model CustomDomainAccountHistory {
  id           String                       @id @default(uuid())
  instanceId   String                       @map("instance_id")
  domain       String
  eventType    CustomDomainAccountEventType @map("event_type")
  fromAccountId String?                     @map("from_account_id")
  toAccountId   String?                     @map("to_account_id")
  actorUserId  String?                      @map("actor_user_id")
  metadataJsonb Json?                       @map("metadata_jsonb")
  createdAt    DateTime                     @default(now()) @map("created_at")

  instance    Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fromAccount CloudflareAccount? @relation("DomainHistoryFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount   CloudflareAccount? @relation("DomainHistoryToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  @@index([instanceId, createdAt])
  @@index([domain, createdAt])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("custom_domain_account_history")
}

// ============================================================
// USER-TENANT (Maps users to tenants with roles)
// ============================================================

model UserTenant {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  tenantId  String           @map("tenant_id")
  roleId    String           @map("role_id")
  isOwner   Boolean          @default(false) @map("is_owner")
  status    UserTenantStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_tenants")
}

enum UserTenantStatus {
  active
  inactive
}

// ============================================================
// ROLE (Per-tenant custom roles)
// ============================================================

model Role {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserTenant[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

// ============================================================
// PERMISSION (Pre-defined system permissions — not tenant-scoped)
// ============================================================

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

// ============================================================
// ROLE-PERMISSION (Many-to-many junction)
// ============================================================

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// PASSWORD RESET TOKEN (Not tenant-scoped)
// ============================================================

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ============================================================
// REFRESH TOKEN (For logout/token revocation — not tenant-scoped)
// ============================================================

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ReferralAction {
  allow
  verify
  review
  block
}

enum ReferralClaimStatus {
  pending
  verify
  review
  blocked
  rewarded
}

// ============================================================
// DEVICE FINGERPRINTS + REFERRAL FRAUD (Global, not tenant-scoped)
// ============================================================

model DeviceFingerprint {
  id              String   @id @default(uuid())
  fingerprintHash String   @map("fingerprint_hash")
  persistentToken String?  @map("persistent_token")
  ipAddress       String?  @map("ip_address") @db.Inet
  webglVendor     String?  @map("webgl_vendor")
  webglRenderer   String?  @map("webgl_renderer")
  screenSignals   Json?    @map("screen_signals")
  hardwareSignals Json?    @map("hardware_signals")
  evasionFlags    Json?    @map("evasion_flags")
  componentsJsonb Json?    @map("components_jsonb")
  riskScore       Int      @default(0) @map("risk_score")
  createdAt       DateTime @default(now()) @map("created_at")

  accountDevices   AccountDevice[]
  referralFraudLog ReferralFraudLog[] @relation("ReferralSharedDevice")
  referralClaims   ReferralClaim[]

  @@index([fingerprintHash])
  @@index([persistentToken])
  @@index([ipAddress, createdAt])
  @@map("device_fingerprints")
}

model AccountDevice {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  deviceId  String   @map("device_id")
  linkedAt  DateTime @default(now()) @map("linked_at")
  isPrimary Boolean  @default(false) @map("is_primary")

  device DeviceFingerprint @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([accountId, deviceId])
  @@index([accountId])
  @@map("account_devices")
}

model ReferralProfile {
  id            String   @id @default(uuid())
  accountId     String   @unique @map("account_id")
  referralCode  String   @unique @map("referral_code")
  totalReferrals Int     @default(0) @map("total_referrals")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  referrerClaims ReferralClaim[] @relation("ReferralClaimsByReferrer")
  pointsWallet   ReferralPointsWallet?

  @@index([referralCode])
  @@map("referral_profiles")
}

model ReferralFraudProof {
  id             String         @id @default(uuid())
  accountId      String         @map("account_id")
  referralCode   String?        @map("referral_code")
  deviceId       String         @map("device_id")
  riskScore      Int            @default(0) @map("risk_score")
  actionTaken    ReferralAction @default(allow) @map("action_taken")
  flags          String[]
  proofTokenHash String         @unique @map("proof_token_hash")
  expiresAt      DateTime       @map("expires_at")
  consumedAt     DateTime?      @map("consumed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  claims ReferralClaim[]

  @@index([accountId, createdAt])
  @@index([expiresAt])
  @@map("referral_fraud_proofs")
}

model ReferralClaim {
  id           String              @id @default(uuid())
  referrerId   String              @map("referrer_id")
  refereeId    String              @unique @map("referee_id")
  referralCode String              @map("referral_code")
  riskScore    Int                 @default(0) @map("risk_score")
  actionTaken  ReferralAction      @default(allow) @map("action_taken")
  status       ReferralClaimStatus @default(pending)
  flags        String[]
  deviceId     String?             @map("device_id")
  fraudProofId String?             @map("fraud_proof_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  reviewedAt   DateTime?           @map("reviewed_at")
  rewardedAt   DateTime?           @map("rewarded_at")

  referrerProfile    ReferralProfile      @relation("ReferralClaimsByReferrer", fields: [referrerId], references: [accountId], onDelete: Cascade)
  device             DeviceFingerprint?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  fraudProof         ReferralFraudProof?  @relation(fields: [fraudProofId], references: [id], onDelete: SetNull)
  rewardEvents       ReferralRewardEvent[]
  enterpriseApprovals EnterpriseRewardApproval[]

  @@index([referrerId])
  @@index([referralCode])
  @@index([status])
  @@map("referral_claims")
}

model ReferralRewardEvent {
  id               String                  @id @default(uuid())
  claimId          String?                 @map("claim_id")
  chargeId         String?                 @map("charge_id")
  referrerId       String                  @map("referrer_id")
  refereeId        String                  @map("referee_id")
  milestone        ReferralRewardMilestone
  basePoints       Int                     @map("base_points")
  multiplier       Decimal                 @db.Decimal(6, 3)
  awardedPoints    Int                     @map("awarded_points")
  status           ReferralRewardStatus    @default(granted)
  approvedByUserId String?                 @map("approved_by_user_id")
  approvedAt       DateTime?               @map("approved_at")
  grantedAt        DateTime?               @map("granted_at")
  rejectionReason  String?                 @map("rejection_reason")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  claim              ReferralClaim?           @relation(fields: [claimId], references: [id], onDelete: SetNull)
  charge             BillingCharge?           @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  pointEntries       ReferralPointsLedger[]
  enterpriseApproval EnterpriseRewardApproval?

  @@unique([refereeId, milestone])
  @@index([referrerId, status])
  @@index([claimId])
  @@map("referral_reward_events")
}

model ReferralPointsWallet {
  id             String   @id @default(uuid())
  accountId      String   @unique @map("account_id")
  availablePoints Int     @default(0) @map("available_points")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profile     ReferralProfile @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  entries     ReferralPointsLedger[]
  redemptions ReferralRedemption[]

  @@map("referral_points_wallets")
}

model ReferralRedemption {
  id             String                   @id @default(uuid())
  accountId      String                   @map("account_id")
  tenantId       String                   @map("tenant_id")
  walletId       String                   @map("wallet_id")
  requestedPoints Int                     @map("requested_points")
  creditedCents  Int                      @map("credited_cents")
  status         ReferralRedemptionStatus @default(completed)
  createdAt      DateTime                 @default(now()) @map("created_at")
  completedAt    DateTime?                @map("completed_at")

  wallet      ReferralPointsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pointEntries ReferralPointsLedger[]
  creditEntries TenantCreditLedger[]

  @@index([accountId, createdAt])
  @@index([tenantId, createdAt])
  @@map("referral_redemptions")
}

model ReferralPointsLedger {
  id            String                 @id @default(uuid())
  walletId      String                 @map("wallet_id")
  accountId     String                 @map("account_id")
  rewardEventId String?                @map("reward_event_id")
  redemptionId  String?                @map("redemption_id")
  sourceEntryId String?                @map("source_entry_id")
  entryType     ReferralPointLedgerType @map("entry_type")
  points        Int
  remainingPoints Int?                 @map("remaining_points")
  expiresAt     DateTime?              @map("expires_at")
  note          String?
  createdAt     DateTime               @default(now()) @map("created_at")

  wallet            ReferralPointsWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  rewardEvent       ReferralRewardEvent?  @relation(fields: [rewardEventId], references: [id], onDelete: SetNull)
  redemption        ReferralRedemption?   @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  sourceEntry       ReferralPointsLedger? @relation("ReferralPointsSource", fields: [sourceEntryId], references: [id], onDelete: SetNull)
  consumptionEntries ReferralPointsLedger[] @relation("ReferralPointsSource")

  @@index([walletId, createdAt])
  @@index([accountId, expiresAt])
  @@index([entryType])
  @@map("referral_points_ledger")
}

model EnterpriseRewardApproval {
  id            String                       @id @default(uuid())
  rewardEventId String                       @unique @map("reward_event_id")
  claimId       String                       @map("claim_id")
  reviewerUserId String                      @map("reviewer_user_id")
  tier          EnterpriseRewardTier
  approvedPoints Int                         @map("approved_points")
  status        EnterpriseRewardReviewStatus @default(approved)
  reason        String?
  createdAt     DateTime                     @default(now()) @map("created_at")

  rewardEvent ReferralRewardEvent @relation(fields: [rewardEventId], references: [id], onDelete: Cascade)
  claim       ReferralClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([reviewerUserId, createdAt])
  @@map("enterprise_reward_approvals")
}

model ReferralFraudLog {
  id             String   @id @default(uuid())
  referrerId     String?  @map("referrer_id")
  refereeId      String?  @map("referee_id")
  referralCode   String?  @map("referral_code")
  riskScore      Int?     @map("risk_score")
  actionTaken    String?  @map("action_taken")
  flags          String[]
  sharedDeviceId String?  @map("shared_device_id")
  createdAt      DateTime @default(now()) @map("created_at")

  sharedDevice DeviceFingerprint? @relation("ReferralSharedDevice", fields: [sharedDeviceId], references: [id], onDelete: SetNull)

  @@map("referral_fraud_log")
}

// ============================================================
// CUSTOMERS (Instance-scoped)
// ============================================================

model Customer {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  instanceId String   @map("instance_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String
  phone      String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  instance  Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  inquiries Inquiry[]

  @@unique([instanceId, email])
  @@index([tenantId])
  @@index([instanceId])
  @@map("customers")
}

// ============================================================
// SERVICES (Instance-scoped)
// ============================================================

model Service {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  instanceId  String   @map("instance_id")
  name        String
  description String?
  duration    Int // minutes
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instance Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@index([instanceId])
  @@index([instanceId, isActive])
  @@index([instanceId, sortOrder])
  @@map("services")
}

// ============================================================
// PRODUCTS (Instance-scoped)
// ============================================================

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  instanceId  String   @map("instance_id")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  // E-commerce extensions (additive — see ecommerce design doc)
  status          ProductStatus @default(draft)
  supplierId      String?       @map("supplier_id")
  supplierItemRef String?       @map("supplier_item_ref")
  sourceUrl       String?       @map("source_url")
  costPrice       Decimal?      @db.Decimal(10, 2) @map("cost_price")
  compareAtPrice  Decimal?      @db.Decimal(10, 2) @map("compare_at_price")
  slug            String?
  galleryJsonb    Json?         @map("gallery_jsonb")
  shippingInfo    String?       @map("shipping_info")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instance Instance         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([tenantId])
  @@index([instanceId])
  @@index([instanceId, isActive])
  @@index([instanceId, sortOrder])
  @@index([instanceId, status])
  @@map("products")
}

// ============================================================
// BLOG POSTS (Instance-scoped)
// ============================================================

model BlogPost {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  instanceId       String   @map("instance_id")
  title            String
  slug             String
  excerpt          String?
  contentHtml      String   @map("content_html")
  featuredImageUrl String?  @map("featured_image_url")
  seoJsonb         Json?    @map("seo_jsonb")
  isPublished      Boolean  @default(false) @map("is_published")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, slug])
  @@index([tenantId])
  @@index([instanceId])
  @@index([instanceId, isPublished])
  @@index([instanceId, publishedAt])
  @@map("blog_posts")
}

// ============================================================
// BOOKINGS (Instance-scoped)
// ============================================================

model Booking {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  instanceId String        @map("instance_id")
  customerId String        @map("customer_id")
  serviceId  String        @map("service_id")
  startTime  DateTime      @map("start_time")
  endTime    DateTime      @map("end_time")
  status     BookingStatus @default(pending)
  notes      String?
  totalPrice Decimal       @db.Decimal(10, 2) @map("total_price")
  currency   String        @default("USD")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@index([tenantId])
  @@index([instanceId])
  @@index([instanceId, startTime])
  @@index([instanceId, status])
  @@map("bookings")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

// ============================================================
// INQUIRIES (Instance-scoped)
// ============================================================

model Inquiry {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  instanceId String        @map("instance_id")
  customerId String?       @map("customer_id")
  name       String
  email      String
  phone      String?
  message    String
  sourceType String?       @map("source_type")
  sourcePageSlug String?   @map("source_page_slug")
  orderId    String?       @map("order_id")
  status     InquiryStatus @default(new)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  instance Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([instanceId])
  @@index([instanceId, status])
  @@index([instanceId, sourceType, sourcePageSlug])
  @@map("inquiries")
}

enum InquiryStatus {
  new
  in_progress
  resolved
  spam
}

// ============================================================
// FEEDBACK (Tenant-scoped, immutable submissions)
// ============================================================

model Feedback {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  type             FeedbackType
  score            Int?
  note             String?
  title            String?
  message          String?
  submittedByUserId String      @map("submitted_by_user_id")
  submittedByEmail String       @map("submitted_by_email")
  submittedByName  String       @map("submitted_by_name")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type, createdAt])
  @@index([createdAt])
  @@map("feedback_entries")
}

enum FeedbackType {
  rating
  suggestion
}

// ============================================================
// FEATURE TOGGLES (Instance-scoped)
// ============================================================

model FeatureToggle {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  instanceId String   @map("instance_id")
  toggleKey  String   @map("toggle_key")
  isEnabled  Boolean  @default(false) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, toggleKey])
  @@index([tenantId])
  @@index([instanceId])
  @@map("feature_toggles")
}

// ============================================================
// INDUSTRY (Global catalog — not tenant-scoped)
// ============================================================

model Industry {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  instances Instance[]
  features  IndustryFeature[]

  @@map("industries")
}

// ============================================================
// FEATURE (Global catalog — not tenant-scoped)
// ============================================================

model Feature {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  industries IndustryFeature[]
  themes     Theme[]

  @@map("features")
}

// ============================================================
// INDUSTRY-FEATURE (Junction table)
// ============================================================

model IndustryFeature {
  id         String @id @default(uuid())
  industryId String @map("industry_id")
  featureId  String @map("feature_id")

  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([industryId, featureId])
  @@map("industry_features")
}

// ============================================================
// THEME (Global catalog — not tenant-scoped)
// ============================================================

model Theme {
  id                String   @id @default(uuid())
  featureId         String   @map("feature_id")
  name              String
  slug              String
  version           Int      @default(1)
  componentKey      String   @map("component_key")
  accessRank        Int      @default(100) @map("access_rank")
  schemaJsonb       Json     @map("schema_jsonb")
  defaultStylesJsonb Json    @map("default_styles_jsonb")
  previewImageUrl   String?  @map("preview_image_url")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  feature      Feature       @relation(fields: [featureId], references: [id], onDelete: Cascade)
  pageSections PageSection[]

  @@unique([slug, version])
  @@index([featureId])
  @@map("themes")
}

// ============================================================
// PAGE TEMPLATE (Global catalog — predefined sections layout)
// ============================================================

model PageTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  previewImageUrl String?  @map("preview_image_url")
  sectionsJsonb   Json     @map("sections_jsonb")
  isPremium       Boolean  @default(false) @map("is_premium")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("page_templates")
}

enum MediaUploadStatus {
  pending
  uploaded
  failed
}

model MediaAsset {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  instanceId    String            @map("instance_id")
  uploadedBy    String?           @map("uploaded_by")
  fileName      String            @map("file_name")
  objectKey     String            @unique @map("object_key")
  mimeType      String            @map("mime_type")
  fileSize      Int               @map("file_size")
  bucketName    String            @map("bucket_name")
  publicUrl     String            @map("public_url")
  status        MediaUploadStatus @default(pending)
  metadataJsonb Json?             @map("metadata_jsonb")
  uploadedAt    DateTime?         @map("uploaded_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([instanceId])
  @@index([status])
  @@index([instanceId, createdAt])
  @@map("media_assets")
}


// ============================================================
// PAGE (Instance-scoped — website pages)
// ============================================================

model Page {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  instanceId  String   @map("instance_id")
  slug        String
  title       String
  seoJsonb    Json?    @map("seo_jsonb")
  isPublished Boolean  @default(false) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  instance Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  sections PageSection[]

  @@unique([instanceId, slug])
  @@index([tenantId])
  @@index([instanceId])
  @@map("pages")
}

// ============================================================
// PAGE SECTION (Instance-scoped — ordered theme instances on a page)
// ============================================================

model PageSection {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  instanceId       String   @map("instance_id")
  pageId           String   @map("page_id")
  themeId          String   @map("theme_id")
  themeVersionUsed Int      @default(1) @map("theme_version_used")
  position         Int      @default(0)
  enabled          Boolean  @default(true)
  contentJsonb     Json     @default("{}") @map("content_jsonb")
  stylesJsonb      Json     @default("{}") @map("styles_jsonb")
  conditionsJsonb  Json?    @map("conditions_jsonb")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  theme    Theme    @relation(fields: [themeId], references: [id])

  @@index([pageId, position])
  @@index([tenantId])
  @@index([instanceId])
  @@map("page_sections")
}

// ============================================================
// PUBLISH RECORD (Instance-scoped — tracks published versions)
// ============================================================

model PublishRecord {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  instanceId  String        @map("instance_id")
  version     Int
  status      PublishStatus @default(draft)
  publishedAt DateTime?     @map("published_at")
  publishedBy String        @map("published_by")
  artifactUrl String?       @map("artifact_url")
  manifestJsonb Json?       @map("manifest_jsonb")
  createdAt   DateTime      @default(now()) @map("created_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, version])
  @@index([tenantId])
  @@index([instanceId])
  @@map("publish_records")
}

enum PublishStatus {
  draft
  publishing
  published
  failed
}

// ============================================================
// E-COMMERCE / DROPSHIPPING (Instance-scoped, additive)
// See docs/ecommerce-dropshipping-automation-system-design.md
// instance_id / tenant_id FKs (ON DELETE CASCADE) are defined in
// migration SQL so the large Instance/Tenant models stay untouched.
// ============================================================

model StoreCommerceProfile {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  instanceId        String   @unique @map("instance_id")
  niche             String?
  storeCurrency     String   @default("USD") @map("store_currency")
  legalBusinessName String?  @map("legal_business_name")
  businessAddress   String?  @map("business_address")
  supportEmail      String?  @map("support_email")
  supportPhone      String?  @map("support_phone")
  supportWhatsapp   String?  @map("support_whatsapp")
  shippingPolicy    String?  @map("shipping_policy")
  returnsPolicy     String?  @map("returns_policy")
  refundPolicy      String?  @map("refund_policy")
  privacyPolicy     String?  @map("privacy_policy")
  termsPolicy       String?  @map("terms_policy")
  shippingLeadDays  Int?     @map("shipping_lead_days")
  defaultFxRate     Decimal? @db.Decimal(12, 6) @map("default_fx_rate")
  orderNumberPrefix String?  @map("order_number_prefix")
  nextOrderSeq      Int      @default(1) @map("next_order_seq")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("store_commerce_profiles")
}

model Supplier {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  instanceId     String         @map("instance_id")
  type           SupplierType   @default(aliexpress)
  displayName    String         @map("display_name")
  status         SupplierStatus @default(disconnected)
  credentialEnc  String?        @map("credential_enc")
  tokenExpiresAt DateTime?      @map("token_expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  imports SupplierProductImport[]

  @@index([tenantId])
  @@index([instanceId])
  @@map("suppliers")
}

enum SupplierType {
  aliexpress
}

enum SupplierStatus {
  disconnected
  connected
  expired
  error
}

model SupplierProductImport {
  id                 String       @id @default(uuid())
  tenantId           String       @map("tenant_id")
  instanceId         String       @map("instance_id")
  supplierId         String       @map("supplier_id")
  supplierItemRef    String       @map("supplier_item_ref")
  sourceUrl          String?      @map("source_url")
  rawJsonb           Json         @map("raw_jsonb")
  normalizedJsonb    Json?        @map("normalized_jsonb")
  availabilityJsonb  Json?        @map("availability_jsonb")
  status             ImportStatus @default(imported)
  reviewNote         String?      @map("review_note")
  publishedProductId String?      @map("published_product_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([instanceId, supplierItemRef])
  @@index([tenantId])
  @@index([instanceId, status])
  @@map("supplier_product_imports")
}

enum ImportStatus {
  imported
  needs_review
  approved
  rejected
  published
}

model ProductVariant {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  instanceId         String              @map("instance_id")
  productId          String              @map("product_id")
  sku                String?
  optionsJsonb       Json?               @map("options_jsonb")
  supplierVariantRef String?             @map("supplier_variant_ref")
  supplierSkuId      String?             @map("supplier_sku_id")
  costPrice          Decimal?            @db.Decimal(10, 2) @map("cost_price")
  price              Decimal             @db.Decimal(10, 2)
  compareAtPrice     Decimal?            @db.Decimal(10, 2) @map("compare_at_price")
  currency           String              @default("USD")
  availability       VariantAvailability @default(unknown)
  stockQty           Int?                @map("stock_qty")
  imageUrl           String?             @map("image_url")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([tenantId])
  @@index([instanceId])
  @@index([productId])
  @@map("product_variants")
}

enum ProductStatus {
  draft
  active
  archived
}

enum VariantAvailability {
  in_stock
  low_stock
  out_of_stock
  discontinued
  unknown
}

model PricingRule {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  instanceId   String     @unique @map("instance_id")
  marginType   MarginType @default(percent)
  marginValue  Decimal    @db.Decimal(10, 2) @map("margin_value")
  roundingMode String     @default("end_99") @map("rounding_mode")
  minMargin    Decimal?   @db.Decimal(10, 2) @map("min_margin")
  fxRate       Decimal?   @db.Decimal(12, 6) @map("fx_rate")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("pricing_rules")
}

enum MarginType {
  percent
  fixed
}

model Cart {
  id         String     @id @default(uuid())
  tenantId   String     @map("tenant_id")
  instanceId String     @map("instance_id")
  token      String     @unique
  status     CartStatus @default(active)
  currency   String     @default("USD")
  email      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  items CartItem[]

  @@index([instanceId, status])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(uuid())
  cartId            String   @map("cart_id")
  productId         String   @map("product_id")
  productVariantId  String   @map("product_variant_id")
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @db.Decimal(10, 2) @map("unit_price_snapshot")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

enum CartStatus {
  active
  converted
  abandoned
}

model Order {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  instanceId        String            @map("instance_id")
  orderNumber       String            @map("order_number")
  customerId        String?           @map("customer_id")
  email             String
  phone             String?
  currency          String            @default("USD")
  subtotal          Decimal           @db.Decimal(10, 2)
  shippingTotal     Decimal           @default(0) @db.Decimal(10, 2) @map("shipping_total")
  discountTotal     Decimal           @default(0) @db.Decimal(10, 2) @map("discount_total")
  taxTotal          Decimal           @default(0) @db.Decimal(10, 2) @map("tax_total")
  grandTotal        Decimal           @db.Decimal(10, 2) @map("grand_total")
  estimatedCost     Decimal?          @db.Decimal(10, 2) @map("estimated_cost")
  status            OrderStatus       @default(pending)
  paymentStatus     PaymentStatus     @default(unpaid) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(unfulfilled) @map("fulfillment_status")
  customerNote      String?           @map("customer_note")
  internalNote      String?           @map("internal_note")
  accessToken       String            @unique @map("access_token")
  riskJsonb         Json?             @map("risk_jsonb")
  placedAt          DateTime?         @map("placed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  items          OrderItem[]
  addresses      OrderAddress[]
  events         OrderEvent[]
  payments       Payment[]
  refunds        Refund[]
  supplierOrders SupplierOrder[]
  shipments      Shipment[]

  @@unique([instanceId, orderNumber])
  @@index([tenantId])
  @@index([instanceId, status])
  @@index([instanceId, paymentStatus])
  @@index([instanceId, fulfillmentStatus])
  @@index([instanceId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String   @map("order_id")
  productId          String   @map("product_id")
  productVariantId   String   @map("product_variant_id")
  nameSnapshot       String   @map("name_snapshot")
  optionsSnapshot    Json?    @map("options_snapshot")
  skuSnapshot        String?  @map("sku_snapshot")
  supplierItemRef    String?  @map("supplier_item_ref")
  supplierVariantRef String?  @map("supplier_variant_ref")
  quantity           Int
  unitPrice          Decimal  @db.Decimal(10, 2) @map("unit_price")
  unitCost           Decimal? @db.Decimal(10, 2) @map("unit_cost")
  lineTotal          Decimal  @db.Decimal(10, 2) @map("line_total")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id          String      @id @default(uuid())
  orderId     String      @map("order_id")
  type        AddressType
  fullName    String      @map("full_name")
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?     @map("postal_code")
  countryCode String      @map("country_code")
  phone       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_addresses")
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  type      String
  actor     String   @default("system")
  message   String?
  dataJsonb Json?    @map("data_jsonb")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

enum AddressType {
  shipping
  billing
}

enum OrderStatus {
  pending
  awaiting_payment
  paid
  awaiting_approval
  approved
  fulfilling
  shipped
  delivered
  cancelled
  refunded
  on_hold
}

enum PaymentStatus {
  unpaid
  authorized
  paid
  partially_refunded
  refunded
  failed
}

enum FulfillmentStatus {
  unfulfilled
  awaiting_approval
  approved
  supplier_ordered
  in_transit
  delivered
  failed
  cancelled
}

model Payment {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  instanceId  String          @map("instance_id")
  orderId     String          @map("order_id")
  provider    PaymentProvider
  providerRef String?         @map("provider_ref")
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD")
  status      PaymentStatus   @default(unpaid)
  methodJsonb Json?           @map("method_jsonb")
  capturedAt  DateTime?       @map("captured_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([orderId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id           String          @id @default(uuid())
  provider     PaymentProvider
  eventId      String          @map("event_id")
  payloadJsonb Json            @map("payload_jsonb")
  processedAt  DateTime?       @map("processed_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model Refund {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  instanceId  String          @map("instance_id")
  orderId     String          @map("order_id")
  paymentId   String?         @map("payment_id")
  provider    PaymentProvider
  providerRef String?         @map("provider_ref")
  amount      Decimal         @db.Decimal(10, 2)
  reason      String?
  status      RefundStatus    @default(pending)
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([orderId])
  @@map("refunds")
}

enum PaymentProvider {
  stripe
  paypal
  local
}

enum RefundStatus {
  pending
  processing
  succeeded
  failed
}

model SupplierOrder {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  instanceId       String              @map("instance_id")
  orderId          String              @map("order_id")
  supplierId       String              @map("supplier_id")
  status           SupplierOrderStatus @default(awaiting_approval)
  supplierOrderRef String?             @map("supplier_order_ref")
  placedCost       Decimal?            @db.Decimal(10, 2) @map("placed_cost")
  currency         String              @default("USD")
  approvedBy       String?             @map("approved_by")
  approvedAt       DateTime?           @map("approved_at")
  placedAt         DateTime?           @map("placed_at")
  idempotencyKey   String              @unique @map("idempotency_key")
  requestJsonb     Json?               @map("request_jsonb")
  responseJsonb    Json?               @map("response_jsonb")
  errorMessage     String?             @map("error_message")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([instanceId, status])
  @@index([orderId])
  @@map("supplier_orders")
}

model Shipment {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  instanceId          String         @map("instance_id")
  orderId             String         @map("order_id")
  supplierOrderId     String?        @map("supplier_order_id")
  carrier             String?
  trackingNumber      String?        @map("tracking_number")
  trackingUrl         String?        @map("tracking_url")
  status              ShipmentStatus @default(pending)
  shippedAt           DateTime?      @map("shipped_at")
  estimatedDeliveryAt DateTime?      @map("estimated_delivery_at")
  deliveredAt         DateTime?      @map("delivered_at")
  eventsJsonb         Json?          @map("events_jsonb")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([orderId])
  @@map("shipments")
}

enum SupplierOrderStatus {
  awaiting_approval
  approved
  placing
  placed
  failed
  cancelled
}

enum ShipmentStatus {
  pending
  in_transit
  out_for_delivery
  delivered
  exception
  cancelled
}

model AutomationTask {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id")
  instanceId   String?   @map("instance_id")
  type         String
  payloadJsonb Json      @map("payload_jsonb")
  runAt        DateTime  @default(now()) @map("run_at")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5) @map("max_attempts")
  status       String    @default("queued")
  lockedAt     DateTime? @map("locked_at")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@index([instanceId])
  @@map("automation_tasks")
}
