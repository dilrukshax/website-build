{
    "name": "@project-aurora/database",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rimraf dist",
        "lint": "eslint src/",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
        "db:cleanup-users": "ts-node --project tsconfig.seed.json prisma/cleanup-user-data.ts"
    },
    "prisma": {
        "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
    },
    "dependencies": {
        "@project-aurora/core": "workspace:*",
        "@prisma/client": "^5.22.0",
        "bcryptjs": "^2.4.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20.19.35",
        "prisma": "^5.22.0",
        "rimraf": "^5.0.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.3.0"
    }
}
