{
    "name": "project-aurora",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.30.3",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "description": "Project Aurora multi-tenant website builder platform",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "clean": "turbo run clean",
        "db:migrate": "pnpm --filter @project-aurora/database run db:migrate",
        "db:seed": "pnpm --filter @project-aurora/database run db:seed",
        "db:cleanup-users": "pnpm --filter @project-aurora/database run db:cleanup-users",
        "start:api": "pnpm --filter @project-aurora/website-builder-api run start",
        "start:web": "pnpm --filter @project-aurora/website-builder-web run start"
    },
    "devDependencies": {
        "turbo": "^2.0.0",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}
