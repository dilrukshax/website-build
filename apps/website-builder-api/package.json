{
    "name": "@project-aurora/website-builder-api",
    "version": "1.0.0",
    "private": true,
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "start": "node dist/server.js",
        "clean": "rimraf dist",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "referrals:sweep-expired-points": "ts-node src/scripts/referral-expiry-sweep.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1003.0",
        "@aws-sdk/s3-request-presigner": "^3.1003.0",
        "@project-aurora/auth": "workspace:*",
        "@project-aurora/core": "workspace:*",
        "@project-aurora/database": "workspace:*",
        "@project-aurora/types": "workspace:*",
        "axios": "^1.13.6",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.0",
        "express": "^4.18.0",
        "express-rate-limit": "^8.3.0",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "sanitize-html": "^2.17.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@project-aurora/config": "workspace:*",
        "@types/axios": "^0.14.4",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/sanitize-html": "^2.16.1",
        "@types/supertest": "^7.2.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "rimraf": "^5.0.0",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.0",
        "vitest": "^4.0.18"
    }
}
