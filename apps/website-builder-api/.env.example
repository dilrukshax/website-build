# API service environment — canonical variables only.
# The single source of truth is the root .env.example.
# Legacy alias names are still accepted as silent fallbacks but should not be set.

NODE_ENV=production
PORT=5074

# Database
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=production_secret_key_change_me_later
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_SECRET=production_refresh_key_change_me_later
JWT_REFRESH_TOKEN_EXPIRY=7d

# Origins (canonical)
WEBSITE_BUILDER_API_URL=https://api.example.com
WEBSITE_BUILDER_WEB_URL=https://cms.example.com
SITE_DOMAIN=buildmyonlineweb.site

# CORS — comma-separated list of allowed CMS origins
CORS_ORIGIN=https://cms.example.com

# Cross-service trust (must match CMS value)
WEB_PROXY_SHARED_SECRET=

# Cloudflare cache purge
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Cloudflare R2 / CDN artifact serving
R2_PUBLIC_URL=
PUBLISHED_SITES_BASE_URL=
ROUTING_INDEX_CURRENT_URL=
ROUTING_INDEX_CACHE_TTL_MS=30000
PUBLISHED_SITES_PRUNE_OLD_VERSIONS=true

# Custom domain
CUSTOM_DOMAIN_REQUIRED_NAMESERVERS=
CUSTOM_DOMAIN_DNS_LOOKUP_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=info

# Discord notifications
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=3500

# Device fingerprint / referral fraud controls
NEXT_PUBLIC_FINGERPRINT_ENABLED=true
FINGERPRINT_ENABLED=true
FINGERPRINT_MODE=log
DEVICE_CHECK_RATE_LIMIT_PER_MIN=10
IPINFO_TOKEN=

# Seed admin (first run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=12345678
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_TENANT_NAME=Project Aurora
