    it('ignores additive fingerprint payload keys and still succeeds', async () => {
        const response = await request(createApp())
            .post('/auth/register')
            .send({
                email: 'test2@example.com',
                password: 'Password123!',
                fullName: 'Test User',
                whatsappNumber: '+94 77 123 4568',
