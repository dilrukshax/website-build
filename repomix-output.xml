<file path="apps/website-builder-web/app/globals.css">
@import "tailwindcss";
@custom-variant dark (&:where(html.dark, html.dark *, html[data-theme='dark'], html[data-theme='dark'] *));

:root {
    --be-primary: #dc2626;
    --be-bg-light: #f6f6f8;
    --be-bg-dark: #121121;
    --be-form-bg: #ffffff;
    --be-form-surface: #f8fafc;
    --be-form-text: #0f172a;
    --be-form-label: #475569;
    --be-form-heading: #0f172a;
