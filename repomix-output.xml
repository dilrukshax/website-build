): ThemeComponentProps {
    const fixture = SECTION_FIXTURES[componentKey] || { content: {}, styles: {} };

    return {
        content: {
            ...fixture.content,
            ...(overrides?.content || {}),
        },
        styles: {
            ...(fixture.styles || {}),
            ...(overrides?.styles || {}),
        },
        tokens: overrides?.tokens || TEST_TOKENS,
        context: overrides?.context || TEST_CONTEXT,
        isEditor: overrides?.isEditor,
    };
}
</file>

