                    <p style={{ margin: 0, maxWidth: '760px', color: '#94a3b8', fontSize: 'clamp(14px, 3.4vw, 16px)' }}>{subtitle}</p>
                </div>

                {visibleProducts.length === 0 ? (
                    <div style={{ textAlign: 'center', color: '#94a3b8' }}>No products are available right now.</div>
