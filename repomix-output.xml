<file path="docker-compose.prod.yml">
version: '3.8'

# =============================================================
# Production Docker Compose — Full Stack
# Database: Neon DB (external) — set DATABASE_URL in .env
# Usage: docker compose -f docker-compose.prod.yml up -d
#
# Before first run:
#   1. Copy .env.example → .env and fill in production values
#   2. Set DATABASE_URL to your Neon DB connection string
#   3. Build images: docker compose -f docker-compose.prod.yml build
#   4. Run migrations: docker compose -f docker-compose.prod.yml run --rm api-migrate
# =============================================================

services:
  # ─── Infrastructure ────────────────────────────────────────

  redis:
    image: redis:7-alpine
    container_name: project-aurora-redis
    restart: unless-stopped
    command: >
      redis-server
        --maxmemory 256mb
        --maxmemory-policy allkeys-lru
        --requirepass ${REDIS_PASSWORD:-redis}
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:-redis}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - backend

  # ─── Database Migration (run once) ─────────────────────────

  api-migrate:
    build:
      context: .
      dockerfile: apps/website-builder-api/Dockerfile
      target: installer
    container_name: project-aurora-api-migrate
    command: >
      sh -c "
        cd packages/database &&
        npx prisma migrate deploy &&
        echo 'Migrations applied'
      "
    environment:
      DATABASE_URL: ${DATABASE_URL:?Set DATABASE_URL in .env (Neon DB connection string)}
    networks:
      - backend
    profiles:
      - migrate

  # ─── API Server ────────────────────────────────────────────

  api:
    build:
      context: .
      dockerfile: apps/website-builder-api/Dockerfile
    container_name: project-aurora-website-builder-api
    restart: unless-stopped
    ports:
      - "${API_PORT:-3002}:3002"
    environment:
      NODE_ENV: production
      PORT: 3002
      WEBSITE_BUILDER_API_URL: ${WEBSITE_BUILDER_API_URL:-http://api:3002}
      WEBSITE_BUILDER_WEB_URL: ${WEBSITE_BUILDER_WEB_URL:-http://cms:3001}
      DATABASE_URL: ${DATABASE_URL:?Set DATABASE_URL in .env (Neon DB connection string)}
      JWT_SECRET: ${JWT_SECRET:?Set JWT_SECRET in .env}
      JWT_REFRESH_SECRET: ${JWT_REFRESH_SECRET:?Set JWT_REFRESH_SECRET in .env}
      JWT_ACCESS_TOKEN_EXPIRY: ${JWT_ACCESS_TOKEN_EXPIRY:-15m}
      JWT_REFRESH_TOKEN_EXPIRY: ${JWT_REFRESH_TOKEN_EXPIRY:-7d}
      CORS_ORIGIN: ${CORS_ORIGIN:-http://localhost:3001}
      LOG_LEVEL: ${LOG_LEVEL:-info}
      REDIS_URL: redis://:${REDIS_PASSWORD:-redis}@redis:6379
      CLOUDFLARE_API_TOKEN: ${CLOUDFLARE_API_TOKEN:?Set CLOUDFLARE_API_TOKEN in .env}
      CLOUDFLARE_ZONE_ID: ${CLOUDFLARE_ZONE_ID:?Set CLOUDFLARE_ZONE_ID in .env}
      CLOUDFLARE_ACCOUNT_ID: ${CLOUDFLARE_ACCOUNT_ID:-}
      CLOUDFLARE_ACCOUNT_TOKEN_ENCRYPTION_KEY: ${CLOUDFLARE_ACCOUNT_TOKEN_ENCRYPTION_KEY:-}
      SITE_DOMAIN: ${SITE_DOMAIN:-buildmyonlineweb.site}
      WEB_PROXY_SHARED_SECRET: ${WEB_PROXY_SHARED_SECRET:-}
      ROUTING_INDEX_CURRENT_URL: ${ROUTING_INDEX_CURRENT_URL:-}
      ROUTING_INDEX_CACHE_TTL_MS: ${ROUTING_INDEX_CACHE_TTL_MS:-30000}
      PUBLISHED_SITES_BASE_URL: ${PUBLISHED_SITES_BASE_URL:-}
      R2_PUBLIC_URL: ${R2_PUBLIC_URL:-}
      R2_ACCESS_KEY_ID: ${R2_ACCESS_KEY_ID:-}
      R2_SECRET_ACCESS_KEY: ${R2_SECRET_ACCESS_KEY:-}
      R2_BUCKET_NAME: ${R2_BUCKET_NAME:-}
      R2_ACCOUNT_ID: ${R2_ACCOUNT_ID:-}
      CUSTOM_DOMAIN_CNAME_TARGET: ${CUSTOM_DOMAIN_CNAME_TARGET:-}
      DISCORD_WEBHOOK_URL: ${DISCORD_WEBHOOK_URL:-}
      DISCORD_WEBHOOK_TIMEOUT_MS: ${DISCORD_WEBHOOK_TIMEOUT_MS:-3500}
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - backend
      - frontend
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '1.0'
        reservations:
          memory: 256M
          cpus: '0.25'

  # ─── CMS (Next.js) ────────────────────────────────────────

  cms:
    build:
      context: .
      dockerfile: apps/website-builder-web/Dockerfile
      args:
        SITE_DOMAIN: ${SITE_DOMAIN:-buildmyonlineweb.site}
    container_name: project-aurora-website-builder-web
    restart: unless-stopped
    ports:
      - "${CMS_PORT:-3001}:3001"
    environment:
      NODE_ENV: production
      WEBSITE_BUILDER_API_URL: ${WEBSITE_BUILDER_API_URL:-http://api:3002}
      WEBSITE_BUILDER_WEB_URL: ${WEBSITE_BUILDER_WEB_URL:-http://cms:3001}
      SITE_DOMAIN: ${SITE_DOMAIN:-buildmyonlineweb.site}
      WEB_PROXY_SHARED_SECRET: ${WEB_PROXY_SHARED_SECRET:-}
      ROUTING_INDEX_CURRENT_URL: ${ROUTING_INDEX_CURRENT_URL:-}
      PUBLISHED_SITES_BASE_URL: ${PUBLISHED_SITES_BASE_URL:-}
    depends_on:
      api:
        condition: service_healthy
    networks:
      - frontend
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '1.0'
        reservations:
          memory: 256M
          cpus: '0.25'

volumes:
  redis_data:
    driver: local

networks:
  backend:
    driver: bridge
  frontend:
    driver: bridge
</file>

<file path="packages/database/src/client.ts">
import { AsyncLocalStorage } from 'async_hooks';
import { PrismaClient } from '@prisma/client';
import { logger } from '@project-aurora/core';

// ============================================================
// Tenant + Instance context storage
// Flows through the entire async request lifecycle automatically.
// Set once in tenant/instance middleware; read in every Prisma query.
// ============================================================

interface TenantContextData {
    tenantId: string;
    instanceId?: string;
}

export const tenantContext = new AsyncLocalStorage<TenantContextData>();

/**
 * setTenantContext — call this in tenant middleware before the request handler.
 * All Prisma queries made during the same async context will be scoped to this tenantId
 * (and optionally instanceId for instance-scoped models).
 */
export function setTenantContext(
    tenantId: string,
    fn: () => Promise<void>,
    instanceId?: string,
): Promise<void> {
    return new Promise((resolve, reject) => {
        tenantContext.run({ tenantId, instanceId }, () => {
            fn().then(resolve).catch(reject);
        });
    });
}

/**
 * Executes work outside tenant context.
 * Useful for internal/global maintenance tasks (e.g. rebuilding global routing indexes).
 */
export function runWithoutTenantContext<T>(fn: () => Promise<T>): Promise<T> {
    return new Promise((resolve, reject) => {
        tenantContext.run(undefined as unknown as TenantContextData, () => {
            fn().then(resolve).catch(reject);
        });
    });
}

// ============================================================
// Models that are exempt from tenant scoping
// (Tenant lookup itself cannot be tenant-scoped)
// ============================================================
const TENANT_EXEMPT_MODELS = new Set([
    'Tenant',
    'User',
    'Permission',
    'PasswordResetToken',
    'RefreshToken',
    'UserTenant',
    'RolePermission',
    'Industry',
    'Feature',
    'IndustryFeature',
    'Theme',
    'PageTemplate',
    'CustomDomainAccountHistory',
    'DeviceFingerprint',
    'AccountDevice',
    'ReferralProfile',
    'ReferralClaim',
    'ReferralFraudProof',
    'ReferralFraudLog',
    'ReferralRewardEvent',
    'ReferralPointsWallet',
    'ReferralPointsLedger',
    'EnterpriseRewardApproval',
    'PlanCatalog',
    'PlanReferralMultiplier',
    'ReferralRewardRule',
]);

// ============================================================
// Models that are scoped at the instance level
// (These have both tenantId and instanceId)
// ============================================================
const INSTANCE_SCOPED_MODELS = new Set([
    'Customer',
    'Service',
    'Product',
    'BlogPost',
    'Booking',
    'Inquiry',
    'FeatureToggle',
    'MediaAsset',
    'Page',
    'PageSection',
    'PublishRecord',
]);

// ============================================================
// Prisma Client with tenant-scope + instance-scope middleware
// ============================================================

function createPrismaClient(): PrismaClient {
    const client = new PrismaClient({
        log: process.env.NODE_ENV === 'development'
            ? ['query', 'warn', 'error']
            : ['warn', 'error'],
    });

    // Tenant + Instance isolation middleware — applied to every query
    client.$use(async (params, next) => {
        const ctx = tenantContext.getStore();
        const model = params.model as string | undefined;

        // Skip tenant scoping for exempt models
        if (!model || TENANT_EXEMPT_MODELS.has(model)) {
            return next(params);
        }

        const tenantId = ctx?.tenantId;
        const instanceId = ctx?.instanceId;
        const isInstanceScoped = INSTANCE_SCOPED_MODELS.has(model);

        // Enforce tenant scoping on read operations
        if (
            params.action === 'findMany' ||
            params.action === 'findFirst' ||
            params.action === 'count' ||
            params.action === 'aggregate'
        ) {
            if (!tenantId) {
                logger.warn(`Tenant context missing for ${model}.${params.action} — query proceeding without scope`);
            } else {
                params.args = params.args ?? {};
                params.args.where = { ...params.args.where, tenantId };

                // Also scope by instanceId for instance-scoped models
                if (isInstanceScoped && instanceId) {
                    params.args.where = { ...params.args.where, instanceId };
                }
            }
        }

        // Enforce tenant scoping on write operations
        if (params.action === 'create' || params.action === 'createMany') {
            if (tenantId) {
                if (params.action === 'create') {
                    params.args.data = { ...params.args.data, tenantId };

                    // Also inject instanceId for instance-scoped models
                    if (isInstanceScoped && instanceId) {
                        params.args.data = { ...params.args.data, instanceId };
                    }
                }
            }
        }

        // Prevent cross-tenant updates/deletes — always inject tenantId in where clause
        if (
            params.action === 'update' ||
            params.action === 'updateMany' ||
            params.action === 'delete' ||
            params.action === 'deleteMany'
        ) {
            if (tenantId) {
                params.args = params.args ?? {};
                params.args.where = { ...params.args.where, tenantId };

                // Also scope by instanceId for instance-scoped models
                if (isInstanceScoped && instanceId) {
                    params.args.where = { ...params.args.where, instanceId };
                }
            }
        }

        return next(params);
    });

    return client;
}

// ============================================================
// Singleton pattern — one Prisma client per process
// ============================================================

const globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };

export const db: PrismaClient = globalForPrisma.prisma ?? createPrismaClient();

if (process.env.NODE_ENV !== 'production') {
    globalForPrisma.prisma = db;
}
</file>

<file path=".env.example">
# =====================================================================
# Project Aurora — Canonical Environment Variables (single source of truth)
# ---------------------------------------------------------------------
# Each concern has ONE canonical variable name. Set it ONCE per service.
# Legacy alias names are still read by the runtime as silent fallbacks,
# but you no longer need to set them. See AGENTS.md for details.
# =====================================================================

# ---- Core runtime ----
NODE_ENV=production
PORT=3002
# API's own public origin (used by API self-links + web proxy secret trust).
WEBSITE_BUILDER_API_URL=https://api.example.com
# CMS/web origin (used by API CORS/host resolution + published-site links).
WEBSITE_BUILDER_WEB_URL=https://cms.example.com
# Root domain used to build persisted instance full domains (subdomain + SITE_DOMAIN).
# NEXT_PUBLIC_SITE_DOMAIN is auto-derived from this for client code.
SITE_DOMAIN=buildmyonlineweb.site

# ---- Database ----
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/booking_engine?sslmode=require

# ---- JWT Authentication ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
# Keep CMS sessions alive only while users are active (minutes). Optional; default 30.
NEXT_PUBLIC_AUTH_IDLE_TIMEOUT_MINUTES=30

# ---- Redis ----
REDIS_PASSWORD=redis

# ---- Cloudflare DNS/CDN cache purge ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TIMEOUT_MS=5000

# ---- Cloudflare R2 (published site artifacts + CMS media uploads) ----
# Use either R2_ENDPOINT (recommended) OR R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for serving uploaded files.
R2_PUBLIC_URL=

# ---- Published-site + routing-index artifact serving ----
# Base URL where published artifacts + the routing-index pointer are served from.
PUBLISHED_SITES_BASE_URL=
# Explicit routing-index pointer URL (optional; derived from PUBLISHED_SITES_BASE_URL when empty).
ROUTING_INDEX_CURRENT_URL=
# Runtime cache TTL for routing-index lookups (milliseconds). Default 30000.
ROUTING_INDEX_CACHE_TTL_MS=30000
# Controls whether old versioned manifest artifacts are pruned after publish. Default true.
PUBLISHED_SITES_PRUNE_OLD_VERSIONS=true
# Runtime cache TTL for published manifest payloads in preview runtime (milliseconds). Default 30000.
NEXT_PUBLIC_MANIFEST_CACHE_TTL_MS=30000

# ---- Cross-service trust ----
# Shared secret between CMS /web proxy and API /web host resolver.
# Set the SAME value in both API and CMS runtime environments.
WEB_PROXY_SHARED_SECRET=
# Comma-separated hostnames that must never be treated as tenant/published hosts.
PLATFORM_HOST_BYPASS=

# ---- Logging ----
LOG_LEVEL=info

# ---- Discord notifications (new registration + onboarding domain setup) ----
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=3500

# ---- Device fingerprint / referral fraud controls ----
NEXT_PUBLIC_FINGERPRINT_ENABLED=true
FINGERPRINT_ENABLED=true
FINGERPRINT_MODE=log
DEVICE_CHECK_RATE_LIMIT_PER_MIN=10
IPINFO_TOKEN=

# ---- Custom domain ----
CUSTOM_DOMAIN_REQUIRED_NAMESERVERS=
CUSTOM_DOMAIN_DNS_LOOKUP_TIMEOUT_MS=5000
CUSTOM_DOMAIN_CNAME_TARGET=

# ---- Published-site branding (client-facing) ----
NEXT_PUBLIC_PUBLISHER_TAGLINE=Built Your Website with My Online Web
NEXT_PUBLIC_PUBLISHER_URL=https://buildmyonlineweb.site
# Optional Ecommex widget merchant id (script not injected when empty).
NEXT_PUBLIC_ECOMMEX_MERCHANT_ID=

# ---- Dev/seed (API only) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=12345678
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_TENANT_NAME=Project Aurora

# =====================================================================
# REMOVED LEGACY ALIASES — no longer required (kept only as silent fallbacks):
#   API_BASE_URL, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_WEBSITE_BUILDER_API_URL
#   CMS_URL, NEXT_PUBLIC_CMS_URL
