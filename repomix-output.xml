    --be-form-error: #dc2626;
}

:root,
:root[data-theme='light'] {
    color-scheme: light;
}

:root.dark,
:root[data-theme='dark'] {
    color-scheme: dark;
    --be-form-bg: #0f172a;
    --be-form-surface: #111827;
    --be-form-text: #e2e8f0;
    --be-form-label: #cbd5e1;
    --be-form-heading: #f8fafc;
    --be-form-muted: #94a3b8;
    --be-form-border: #334155;
    --be-form-active-bg: #1e293b;
    --be-form-active-text: #fca5a5;
    --be-form-swatch-border: rgba(148, 163, 184, 0.45);
    --be-form-upload-bg: #1e293b;
    --be-form-upload-bg-disabled: #0f172a;
    --be-form-danger-bg: rgba(127, 29, 29, 0.24);
    --be-form-danger-border: rgba(185, 28, 28, 0.6);
    --be-form-danger-text: #fca5a5;
    --be-form-error: #fca5a5;
}

body {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
}

/* Landing hero animations */
@keyframes be-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
}

@keyframes be-float-slow {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-20px) rotate(-2deg); }
}

@keyframes be-rise {
    0% { opacity: 0; transform: translateY(24px); }
    100% { opacity: 1; transform: translateY(0); }
}

@keyframes be-pulse-ring {
    0% { transform: scale(0.9); opacity: 0.7; }
    70% { transform: scale(1.35); opacity: 0; }
    100% { transform: scale(1.35); opacity: 0; }
}

@keyframes be-shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
}

@keyframes be-progress {
    0% { width: 12%; }
    50% { width: 92%; }
    100% { width: 12%; }
}

@keyframes be-blob {
    0%, 100% { border-radius: 42% 58% 63% 37% / 42% 42% 58% 58%; transform: translate(0, 0) scale(1); }
    50% { border-radius: 58% 42% 37% 63% / 58% 58% 42% 42%; transform: translate(12px, -12px) scale(1.06); }
}

.be-float { animation: be-float 6s ease-in-out infinite; }
.be-float-slow { animation: be-float-slow 8s ease-in-out infinite; }
.be-float-delayed { animation: be-float 6s ease-in-out infinite; animation-delay: 1.5s; }
.be-rise { animation: be-rise 0.7s ease-out both; }
.be-rise-1 { animation: be-rise 0.7s ease-out 0.1s both; }
.be-rise-2 { animation: be-rise 0.7s ease-out 0.25s both; }
.be-rise-3 { animation: be-rise 0.7s ease-out 0.4s both; }
.be-blob { animation: be-blob 12s ease-in-out infinite; }

.be-pulse-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid var(--be-primary);
    animation: be-pulse-ring 2.4s ease-out infinite;
}

.be-progress-bar {
    animation: be-progress 4s ease-in-out infinite;
}

.be-shimmer {
    background: linear-gradient(90deg, rgba(220,38,38,0) 0%, rgba(220,38,38,0.18) 50%, rgba(220,38,38,0) 100%);
    background-size: 200% 100%;
    animation: be-shimmer 2.5s linear infinite;
}

@media (prefers-reduced-motion: reduce) {
    .be-float, .be-float-slow, .be-float-delayed, .be-rise, .be-rise-1, .be-rise-2, .be-rise-3,
    .be-blob, .be-pulse-ring::before, .be-progress-bar, .be-shimmer {
