                    gap: '24px',
                    justifyContent: 'space-between',
                    alignItems: 'flex-start',
                }}
            >
                <div style={{ maxWidth: '520px' }}>
                    <p
                        style={{
                            margin: 0,
                            fontSize: 'clamp(26px, 4.2vw, 42px)',
                            lineHeight: 1,
                            letterSpacing: '-0.02em',
                            textTransform: 'lowercase',
                            color: '#181818',
                            fontWeight: 700,
                        }}
                    >
                        {brand}
