            fallbackHost: host,
        });

        if (!seo.robotsIndex || !seo.canonicalUrl || seenCanonicalUrls.has(seo.canonicalUrl)) {
            continue;
        }

        seenCanonicalUrls.add(seo.canonicalUrl);
        urls.push(
