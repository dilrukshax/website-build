# Application
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3002
CMS_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
# Primary root domain used to build persisted instance full domains (subdomain + SITE_DOMAIN)
SITE_DOMAIN=buildmyonlineweb.site
# Comma-separated hostnames that should never be treated as tenant/published hosts.
PLATFORM_HOST_BYPASS=

# Database (Neon DB)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/booking_engine?sslmode=require

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
# Keep CMS sessions alive only while users are active (minutes)
# Optional. Default is 30 minutes if not set.
NEXT_PUBLIC_AUTH_IDLE_TIMEOUT_MINUTES=30

# Redis
REDIS_PASSWORD=redis

# Cloudflare DNS/CDN cache purge
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Cloudflare R2 (published site artifacts + CMS media uploads)
# Use either R2_ENDPOINT (recommended from R2 dashboard) OR R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for serving uploaded files (for example r2.dev/custom domain).
R2_PUBLIC_URL=
# Optional explicit base URL for published-site CDN artifacts and routing index.
PUBLISHED_SITES_BASE_URL=
# Optional explicit URL for routing index pointer file.
ROUTING_INDEX_CURRENT_URL=
# Optional runtime cache TTL for routing-index lookups (milliseconds).
ROUTING_INDEX_CACHE_TTL_MS=30000
# Controls whether old `sites/{instanceId}/v*/manifest.json` artifacts are deleted
# after a new publish/rollback upload. `true` keeps only the latest version artifact.
PUBLISHED_SITES_PRUNE_OLD_VERSIONS=true
# Shared secret between CMS /web proxy and API /web host resolver.
# Set the same value in both API and CMS runtime environments.
WEB_PROXY_SHARED_SECRET=

# Logging
LOG_LEVEL=debug

# Discord notifications (new registration + onboarding domain setup)
DISCORD_WEBHOOK_URL=
# Optional aliases also supported by API runtime:
# DISCORD_WEBHOOK_ENDPOINT=
# DISCORD_WEBHOOK=
# WEBHOOK_ENDPOINT=
# WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=3500

# Docker / Production Overrides
API_PORT=3002
CMS_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3002
# Primary domain shown in CMS subdomain UI (e.g., create-instance suffix)
NEXT_PUBLIC_SITE_DOMAIN=buildmyonlineweb.site
# Public CDN base URL used by CMS middleware/preview runtime.
NEXT_PUBLIC_PUBLISHED_SITES_BASE_URL=
# Optional override for routing index pointer URL.
NEXT_PUBLIC_ROUTING_INDEX_CURRENT_URL=
# Optional runtime cache TTL for routing-index lookups (milliseconds).
NEXT_PUBLIC_ROUTING_INDEX_CACHE_TTL_MS=30000
# Optional public override of reserved platform hosts bypass list.
NEXT_PUBLIC_PLATFORM_HOST_BYPASS=
# Optional runtime cache TTL for published manifest payloads in preview runtime (milliseconds).
NEXT_PUBLIC_MANIFEST_CACHE_TTL_MS=30000
# Publisher badge shown on all published pages (subdomain + custom domain)
NEXT_PUBLIC_PUBLISHER_TAGLINE=Built Your Website with My Online Web
NEXT_PUBLIC_PUBLISHER_URL=https://buildmyonlineweb.site
# Optional Ecommex widget merchant ID for global CMS script injection.
# When unset, the script is not injected.
NEXT_PUBLIC_ECOMMEX_MERCHANT_ID=

# Device fingerprint / referral fraud controls
NEXT_PUBLIC_FINGERPRINT_ENABLED=true
FINGERPRINT_ENABLED=true
FINGERPRINT_MODE=log
DEVICE_CHECK_RATE_LIMIT_PER_MIN=10
# Optional secondary provider token for IP reputation checks
IPINFO_TOKEN=

# --- E-commerce / dropshipping (see docs/ecommerce-dropshipping-automation-system-design.md §23) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_OAUTH_REDIRECT_URL=
ALIEXPRESS_API_TIMEOUT_MS=15000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
LOCAL_GATEWAY_MERCHANT_ID=
LOCAL_GATEWAY_SECRET=
COMMERCE_ENCRYPTION_KEY=
COMMERCE_ORDER_TOKEN_SECRET=
AUTOMATION_RUNNER_ENABLED=false
AUTOMATION_POLL_INTERVAL_MS=15000
