# =====================================================================
# Project Aurora — Canonical Environment Variables (single source of truth)
# ---------------------------------------------------------------------
# Each concern has ONE canonical variable name. Set it ONCE per service.
# Legacy alias names are still read by the runtime as silent fallbacks,
# but you no longer need to set them. See AGENTS.md for details.
# =====================================================================

# ---- Core runtime ----
NODE_ENV=production
PORT=3002
# API's own public origin (used by API self-links + web proxy secret trust).
WEBSITE_BUILDER_API_URL=https://api.example.com
# CMS/web origin (used by API CORS/host resolution + published-site links).
WEBSITE_BUILDER_WEB_URL=https://cms.example.com
# Root domain used to build persisted instance full domains (subdomain + SITE_DOMAIN).
# NEXT_PUBLIC_SITE_DOMAIN is auto-derived from this for client code.
SITE_DOMAIN=buildmyonlineweb.site

# ---- Database ----
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/booking_engine?sslmode=require

# ---- JWT Authentication ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
# Keep CMS sessions alive only while users are active (minutes). Optional; default 30.
NEXT_PUBLIC_AUTH_IDLE_TIMEOUT_MINUTES=30

# ---- Redis ----
REDIS_PASSWORD=redis

# ---- Cloudflare DNS/CDN cache purge ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TIMEOUT_MS=5000

# ---- Cloudflare R2 (published site artifacts + CMS media uploads) ----
# Use either R2_ENDPOINT (recommended) OR R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for serving uploaded files.
R2_PUBLIC_URL=

# ---- Published-site + routing-index artifact serving ----
# Base URL where published artifacts + the routing-index pointer are served from.
PUBLISHED_SITES_BASE_URL=
# Explicit routing-index pointer URL (optional; derived from PUBLISHED_SITES_BASE_URL when empty).
ROUTING_INDEX_CURRENT_URL=
# Runtime cache TTL for routing-index lookups (milliseconds). Default 30000.
ROUTING_INDEX_CACHE_TTL_MS=30000
# Controls whether old versioned manifest artifacts are pruned after publish. Default true.
PUBLISHED_SITES_PRUNE_OLD_VERSIONS=true
# Runtime cache TTL for published manifest payloads in preview runtime (milliseconds). Default 30000.
NEXT_PUBLIC_MANIFEST_CACHE_TTL_MS=30000

# ---- Cross-service trust ----
# Shared secret between CMS /web proxy and API /web host resolver.
# Set the SAME value in both API and CMS runtime environments.
WEB_PROXY_SHARED_SECRET=
# Comma-separated hostnames that must never be treated as tenant/published hosts.
PLATFORM_HOST_BYPASS=

# ---- Logging ----
LOG_LEVEL=info

# ---- Discord notifications (new registration + onboarding domain setup) ----
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=3500

# ---- Device fingerprint / referral fraud controls ----
NEXT_PUBLIC_FINGERPRINT_ENABLED=true
FINGERPRINT_ENABLED=true
FINGERPRINT_MODE=log
DEVICE_CHECK_RATE_LIMIT_PER_MIN=10
IPINFO_TOKEN=

# ---- Custom domain ----
CUSTOM_DOMAIN_REQUIRED_NAMESERVERS=
CUSTOM_DOMAIN_DNS_LOOKUP_TIMEOUT_MS=5000
CUSTOM_DOMAIN_CNAME_TARGET=

# ---- Published-site branding (client-facing) ----
NEXT_PUBLIC_PUBLISHER_TAGLINE=Built Your Website with My Online Web
NEXT_PUBLIC_PUBLISHER_URL=https://buildmyonlineweb.site
# Optional Ecommex widget merchant id (script not injected when empty).
NEXT_PUBLIC_ECOMMEX_MERCHANT_ID=

# ---- Dev/seed (API only) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=12345678
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_TENANT_NAME=Project Aurora

# =====================================================================
# REMOVED LEGACY ALIASES — no longer required (kept only as silent fallbacks):
#   API_BASE_URL, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_WEBSITE_BUILDER_API_URL
#   CMS_URL, NEXT_PUBLIC_CMS_URL
#   NEXT_PUBLIC_SITE_DOMAIN (auto-derived from SITE_DOMAIN)
#   NEXT_PUBLIC_ROUTING_INDEX_CURRENT_URL, NEXT_PUBLIC_PUBLISHED_SITES_BASE_URL,
#   NEXT_PUBLIC_ROUTING_INDEX_CACHE_TTL_MS, NEXT_PUBLIC_PLATFORM_HOST_BYPASS
#   API_PORT, CMS_PORT (use PORT per service)
# =====================================================================
