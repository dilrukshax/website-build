# =============================================================
# Azure VM production environment template
# Copy to .env and replace all placeholder values.
# =============================================================

NODE_ENV=production
LOG_LEVEL=info

# Host exposed ports (docker-compose.azure.yml)
API_PORT=3002
CMS_PORT=3001

# Public URLs
API_BASE_URL=https://api.yourdomain.com
CMS_URL=https://app.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com,https://yourdomain.com
SITE_DOMAIN=yourdomain.com
NEXT_PUBLIC_WEBSITE_BUILDER_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
WEBSITE_BUILDER_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SITE_DOMAIN=yourdomain.com

# Database (Azure Database for PostgreSQL Flexible Server)
DATABASE_URL=postgresql://dbuser:password@your-db-server.postgres.database.azure.com:5432/booking_engine?sslmode=require

# Redis
REDIS_PASSWORD=replace-with-strong-password
# Optional: Use Azure Cache for Redis instead of local container.
# REDIS_URL=redis://:password@your-cache.redis.cache.windows.net:6380

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Cloudflare DNS/CDN cache purge (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Cloudflare R2 (optional, required for published artifacts/media uploads)
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
PUBLISHED_SITES_BASE_URL=
ROUTING_INDEX_CURRENT_URL=
ROUTING_INDEX_CACHE_TTL_MS=30000

# Shared secret between CMS /web proxy and API /web host resolver
WEB_PROXY_SHARED_SECRET=replace-with-strong-shared-secret

# Frontend public config
NEXT_PUBLIC_PUBLISHED_SITES_BASE_URL=
NEXT_PUBLIC_ROUTING_INDEX_CURRENT_URL=
NEXT_PUBLIC_ROUTING_INDEX_CACHE_TTL_MS=30000
NEXT_PUBLIC_PUBLISHER_TAGLINE=Built Your Website with My Online Web
NEXT_PUBLIC_PUBLISHER_URL=https://yourdomain.com

# Device fingerprint / referral fraud controls
NEXT_PUBLIC_FINGERPRINT_ENABLED=true
FINGERPRINT_ENABLED=true
FINGERPRINT_MODE=log
DEVICE_CHECK_RATE_LIMIT_PER_MIN=10
IPINFO_TOKEN=
